  "id": "ganjagoddessai.app",

  "prefer_related_applications": false,

  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://ganjagoddessai.com"
    }
  ],

  "edge_side_panel": {
    "preferred_width": 420
  },

  "launch_handler": {
    "client_mode": "navigate-existing"
  },

  "handle_links": "preferred",

  "capture_links": "existing-client-navigate",

  "orientation_lock": "natural",

  "protocol_handlers": [
    {
      "protocol": "web+goddessai",
      "url": "/intent?data=%s"
    },
    {
      "protocol": "web+3dpod",
      "url": "/3dpod/intent?data=%s"
    },
    {
      "protocol": "web+xr",
      "url": "/xr/intent?data=%s"
    },
    {
      "protocol": "web+ghostcommerce",
      "url": "/commerce?intent=%s"
    },
    {
      "protocol": "web+orbit",
      "url": "/orbit?node=%s"
    }
  ],

  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "media",
          "accept": [
            "image/*",
            "video/*",
            "application/pdf",
            "model/*",
            "audio/*"
          ]
        }
      ]
    }
  },

  "file_handlers": [
    {
      "action": "/files",
      "accept": {
        "image/*": [".png", ".jpg", ".jpeg", ".webp", ".gif", ".svg"],
        "application/pdf": [".pdf"],
        "text/plain": [".txt", ".md"],
        "model/*": [".obj", ".glb", ".gltf", ".stl", ".fbx"],
        "audio/*": [".mp3", ".wav", ".ogg"],
        "video/*": [".mp4", ".webm"]
      }
    }
  ],

  "scope_extensions": [
    { "origin": "https://ganjagoddessai.com" },
    { "origin": "https://cdn.ganjagoddessai.com" },
    { "origin": "https://api.ganjagoddessai.com" }
  ],

  "permissions_policy": {
    "camera": ["self"],
    "microphone": ["self"],
    "geolocation": ["self"],
    "fullscreen": ["self"],
    "xr-spatial-tracking": ["self"],
    "usb": ["self"],
    "screen-wake-lock": ["self"],
    "clipboard-read": ["self"],
    "clipboard-write": ["self"],
    "gyroscope": ["self"],
    "accelerometer": ["self"],
    "payment": ["self"],
    "notifications": ["self"]
  },

  "background": {
    "theme": "orbital-smoke-neural-grid",
    "particles": true,
    "dynamic_lighting": true,
    "shader_pipeline": "webgl2",
    "parallax_depth": true
  },

  "ai_system": {
    "default_persona": "ganjagoddess",
    "voice_enabled": true,
    "memory_mode": "persistent",
    "emotion_engine": true,
    "intent_detection": true,
    "semantic_navigation": true,
    "predictive_suggestions": true,
    "multi_agent_mode": true
  },

  "commerce": {
    "ghost_mode": true,
    "dropshipping": true,
    "eco_friendly_only": true,
    "3dpod_enabled": true,
    "affiliate_engine": true,
    "dynamic_pricing": true,
    "smart_upsells": true,
    "autonomous_recommendations": true
  },

  "xr_features": {
    "ar_enabled": true,
    "vr_enabled": true,
    "webxr_enabled": true,
    "hand_tracking": true,
    "spatial_audio": true,
    "3d_environment": true
  },

  "performance": {
    "adaptive_rendering": true,
    "low_power_mode": true,
    "gpu_acceleration": true,
    "lazy_loading": true,
    "offline_shell": true,
    "streaming_assets": true
  },

  "dependencies": {
    "runtime": {
      "react": "^18.3.0",
      "react-dom": "^18.3.0",
      "next": "^14.2.0",
      "typescript": "^5.5.0",
      "zod": "^3.23.0",
      "zustand": "^4.5.0",
      "framer-motion": "^11.0.0",
      "three": "^0.165.0",
      "webxr-polyfill": "^2.0.0",
      "socket.io-client": "^4.7.0",
      "axios": "^1.7.0",
      "rxjs": "^7.8.0",
      "openai": "^4.0.0",
      "tweakpane": "^4.0.0",
      "d3": "^7.9.0",
      "dayjs": "^1.11.0",
      "uuid": "^9.0.0"
    },
    "ai": {
      "langchain": "^0.2.0",
      "llamaindex": "^0.10.0",
      "transformers": "^4.41.0",
      "onnxruntime-web": "^1.18.0"
    },
    "xr": {
      "react-three-fiber": "^8.16.0",
      "drei": "^9.107.0",
      "webxr": "native",
      "aframe": "^1.5.0"
    },
    "commerce": {
      "stripe": "^16.0.0",
      "paypal-sdk": "^5.0.0"
    },
    "database": {
      "mongoose": "^8.5.0",
      "redis": "^4.7.0"
    },
    "logging": {
      "winston": "^3.13.0",
      "pino": "^9.0.0"
    },
    "security": {
      "jsonwebtoken": "^9.0.0",
      "bcryptjs": "^2.4.0",
      "helmet": "^7.1.0"
    }
  },

  "devDependencies": {
    "build": {
      "vite": "^5.4.0",
      "webpack": "^5.94.0",
      "esbuild": "^0.23.0",
      "ts-node": "^10.9.0"
    },
    "linting": {
      "eslint": "^9.0.0",
      "prettier": "^3.3.0",
      "husky": "^9.0.0"
    },
    "testing": {
      "jest": "^29.7.0",
      "vitest": "^2.0.0",
      "cypress": "^13.0.0"
    },
    "tooling": {
      "nodemon": "^3.1.0",
      "concurrently": "^8.2.0",
      "dotenv": "^16.4.0"
    }
  },

  "peerDependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },

  "optionalDependencies": {
    "sharp": "^0.33.0",
    "fsevents": "^2.3.0"
  },

  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest",
    "xr": "node xr-server.js",
    "ai": "node ai-engine.js",
    "sync": "node sync-service.js"
  },

  "architecture": {
    "pattern": "event-driven microservices",
    "frontend": "Next.js + React + WebXR",
    "backend": "Node.js API gateway + microservices",
    "ai_layer": "multi-agent LLM orchestration",
    "data_layer": "MongoDB + Redis + vector DB",
    "realtime_layer": "WebSockets + event bus",
    "rendering_layer": "Three.js + WebGL2 + shaders"
  },

  "services": {
    "api_gateway": true,
    "auth_service": true,
    "ai_orchestrator": true,
    "commerce_engine": true,
    "xr_engine": true,
    "delivery_orchestrator": true,
    "analytics_pipeline": true,
    "vector_search": true
  },

  "env": {
    "NODE_ENV": "production",
    "API_BASE_URL": "https://api.ganjagoddessai.com",
    "XR_MODE": "enabled",
    "AI_MODE": "multi-agent",
    "LOG_LEVEL": "info"
  },

  "build": {
    "target": "es2022",
    "minify": true,
    "source_maps": true,
    "tree_shaking": true,
    "code_splitting": true
  },

  "featureFlags": {
    "enable_orbital_ui": true,
    "enable_ai_agents": true,
    "enable_xr_mode": true,
    "enable_voice_control": true,
    "enable_autonomous_commerce": true,
    "enable_predictive_ui": true
  },

  "security": {
    "auth_strategy": "jwt + refresh_tokens",
    "encryption": "AES-256",
    "rate_limiting": true,
    "cors_policy": "strict",
    "content_sanitization": true
  },

  "compliance": {
    "gdpr": true,
    "ccpa": true,
    "age_gate": true,
    "data_retention_policy": "configurable",
    "audit_logging": true
  }
}
